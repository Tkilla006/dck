<Entities>	

	<Entity name="Melee Guy" type="Human" fogOfWarVisibility="hidden" editorAutoHeight="false" editorTags="enemy,rabble">
		<RenderObject3D model="data/models/humans/enemy_1.khm" diffuseTex="data/models/humans/enemy_base_diffuse1.dds"/>
		<RenderObject3D model="data/models/humans/attachments/enemy_head_beard.khm" diffuseTex="data/models/humans/attachments/enemy_head.dds"/>
		<Breakable template="GenericHumanGibs" breakOnDamage="explosive" deleteOnDeath="false"/>
		<PhysicalParams health="100" />
		<Human type="BadGuy">
			<FOV degrees="75" distanceMeters="999" eyeRadiusMeters="1.0"/>
			<Brain startingBehavior="Normal Guy" defaultBehavior="Normal Guy" combatBehavior="Normal Combat" suppressionRecovery="5.0"/>
			<Id name="@entity_human_rabblefighter" portrait="data/textures/portraits/enemy_grunt_pistol.dds" gender="0" voicePack="enemy arabic"/>
			<Traits chanceToBlindFire="0.0" stopsToShoot="false" />
			<Mobility>
				<MoveSpeed min="1.1" defaultMetersPerSec="2.7" max="9"/>
				<TurnSpeed min="6" defaultMetersPerSec="13" max="20"/>
			</Mobility>

			<Equipment>
				<Item name="Melee Weapon" />
			</Equipment>
		</Human>
	</Entity>
	
	<Entity name="Melee Executioner" type="Human" fogOfWarVisibility="hidden" editorAutoHeight="false" editorTags="enemy,executioner">
		<RenderObject3D model="data/models/humans/enemy_1.khm" diffuseTex="data/models/humans/enemy_base_diffuse2.dds"/>
		<RenderObject3D model="data/models/humans/attachments/enemy_skirt.khm" diffuseTex="data/models/humans/attachments/enemy_skirt_diffuse2.dds" windAnimated="1"/>
		<RenderObject3D model="data/models/humans/attachments/enemy_vest_ammo.khm" diffuseTex="data/models/humans/attachments/enemy_vest_diffuse.dds"/>
		<Breakable template="GenericHumanGibs" breakOnDamage="explosive" deleteOnDeath="false"/>
		<PhysicalParams health="100" />
		<Human type="BadGuy">
			<FOV degrees="90" distanceMeters="999" eyeRadiusMeters="0.6"/>			
			<Brain startingBehavior="Normal Guy" defaultBehavior="Normal Guy" combatBehavior="Executioner" suppressionRecovery="20.0"/>
			<Id name="@entity_human_executioner" portrait="data/textures/portraits/enemy_executioner.dds" gender="0" voicePack="enemy arabic"/>
			<Traits aggressiveness="0.7" chanceToInvestigate="0.2" />
			<Mobility>
				<MoveSpeed min="0.7" defaultMetersPerSec="2.53" max="10"/>
				<TurnSpeed min="6" defaultMetersPerSec="13" max="20"/>
			</Mobility>

			<Equipment>
				<Item name="Executioner Sword" />
			</Equipment>
			
		</Human>
	</Entity>

</Entities>
