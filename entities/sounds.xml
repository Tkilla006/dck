	<!--
	Ambiental sounds

		volume = [0..1]
			default: 1.0

		playCount = 0 (inf) or >0
			default: 0 (inf)

		startChance = [0..1]
			default: 1.0

		secondsBetweenTries >= 0 (seconds)
			default: 5

		minAttenuationDistance >= 0 (meters)
			default: 0

		maxAttenuationDistance >= 0 (meters)
			default: (always heard)

		disableEffects = true | false
			default: false

		trigger = Always (0) | Before combat starts (1) | After combat starts (2) | only when triggered by a Trigger entity (3)
			Causes sound to only play in that circumstance
	-->

