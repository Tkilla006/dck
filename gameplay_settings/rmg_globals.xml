		<Texture mainPath="data/terrain/exterior/tiles_exterior_01.dds" /> <!-- works for interiors too -->
		
		<!-- This SwapSet will only apply to tiles with these tags -->
		
		<!-- Tiles that are in the same tag set will use the same texture in the SwapSet 							-->
		<!-- 	So, for example, all bedrooms and living rooms with wooden floors will have the same tile texture 	-->
		<TagSet>
			<Tag name="bedroom" />
			<Tag name="living" />
			<Tag name="hallway" />
			<Tag name="entrance" />
			<Tag name="storage" />
			<Tag name="kitchen" />
			<Tag name="bathroom" />
		</TagSet>
		
		<Theme name="apartment" />
		<Theme name="residential" />
	</SwapSet>
	
