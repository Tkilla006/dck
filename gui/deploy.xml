		<!--
			This will be renamed as Rangers, CIA, Nowheraki etc, filled as needed by the game, then added below.
				You can also overwrite it and make your own custom version. If the game finds a definition that already exists, it will use that one, instead of creating it.

			See: dk2/data/mods/template_new_squad_with_custom_deploy_ui.zip
		-->
		<Item name="#UnitTemplate" origin="0 -312" hidden="true" align="rt" sizeX="380">

			<!-- will be renamed as Assault, Support, Marksman etc. -->
			<StaticImage name="#ClassTemplate" hidden="true" origin="0 0" align="t">

				<!-- background: Y size will vary
					sizeY = SlotTemplate.y * numRows + #ClassHeader.sizeY + 12
					eg 148 for one row, 238 for two rows
				-->
				<RenderObject2D texture="data/textures/gui/square.tga" sizeX="380" sizeY="148" color="211e1dcc"/>

				<!-- left bar: Y size will vary, will stretch for the same height as parent -->
				<StaticImage name="#ClassBackgroundLeftBar" origin="-16 0" align="lt">
					<RenderObject2D texture="data/textures/gui/square.tga" sizeX="8" sizeY="148" color="f97b0380"/>
				</StaticImage>

