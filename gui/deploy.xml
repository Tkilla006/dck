						<RenderObject2D texture="data/textures/gui/deploy/class_name_icon_assaulter.dds"/>
					</StaticImage>
				</StaticImage>

				<!-- slots row: each row will go below this one, decrementing Y with
					nextRow.y = prevRow.y - SlotTemplate.y
				-->
				<Item name="#SlotsRow" origin="54 -98" align="lt">
					<!-- slots will be here, starting from 0,0 and incrementing X by SlotTemplate.x
						<StaticImage name="#slot0" origin="0 0">
							<RenderObject2D texture="data/textures/gui/deploy/deploy_trooperbackground_01.tga"/>
						</StaticImage>
					-->
				</Item>
