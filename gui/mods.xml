				</RenderObject2D>
			</StaticImage>
			<StaticText align="l" origin="0 0" text="@menu_mods_downloading" font="header_4" textColor="f0e3cc"/>
		</Item>
	</Item>

	<!-- when putting these into the list, we try to fit as many on the first row, with equally spaced columns.
			the subsequent rows will be placed right below, with sizeY in-between them.
	 -->
	<Item name="#Mod_ItemTemplate" hidden="true" origin="0 0" sizeX="450" sizeY="425">
		<OnOpen>
			<Action type="TriggerEvent" target="GUI_GAME_MODS_LISTITEM_IN_VIEW"/>
		</OnOpen>
		<OnClose>
			<Action type="TriggerEvent" target="GUI_GAME_MODS_LISTITEM_OUT_OF_VIEW"/>
		</OnClose>
		<!-- this here for when scrolling on the empty space between the buttons -->
		<OnScrollDown>
			<Action type="ScrollListForward" target="#ModSelect_ItemList"/>
		</OnScrollDown>
		<OnScrollUp>
			<Action type="ScrollListBackward" target="#ModSelect_ItemList"/>
		</OnScrollUp>

		<!-- wrapping everything in another item because we want to control the empty space around items when placed in the list -->
		<Item sizeX="458" sizeY="397">

			<StaticImage origin="0 0" align="c">
				<RenderObject2D texture="data/textures/gui/square.tga" sizeX="458" sizeY="397" color="40392b" />
			</StaticImage>

			<!-- image size must be 16:9, to match the Workshop style -->
			<StaticImage name="#image_disabled" origin="0 -4" align="ct" hidden="true">
				<RenderObject2D texture="data/textures/gui/mod_defaultbg.jpg" sizeX="450" color="ffffffe6"/> <!-- sizeY is 253 -->
			</StaticImage>
			<StaticImage name="#image_enabled" origin="0 -4" align="ct" hidden="false">
				<RenderObject2D texture="data/textures/gui/mod_defaultbg.jpg" sizeX="450" blendMode="none" />
			</StaticImage>

			<!-- footer1: name+author -->
			<StaticImage origin="0 -257" align="tc" clipChildren="true">
				<RenderObject2D texture="data/textures/gui/square.tga" sizeX="450" sizeY="70" color="211e1d"/>

				<StaticText name="#name" origin="6 0" align="lt" text="Reaaaaly long mod name here!" fontAutoDownsize="true" font="header_4" textColor="f0e3cc"/>
				<StaticText name="#author" origin="6 0" align="lb" text="Author Name Very Long" font="paragraph_3" textColor="f0e3cc"/>
			</StaticImage>
			
			<Checkbox name="#checkbox" align="ci" stealFocus="true" hidden="false">
				<OnScrollDown>
					<Action type="ScrollListForward" target="#ModSelect_ItemList"/>
				</OnScrollDown>
				<OnScrollUp>
					<Action type="ScrollListBackward" target="#ModSelect_ItemList"/>
				</OnScrollUp>

				<UncheckedState sizeX="458" sizeY="397">
					<OnOpen>
						<Action type="Show" target="#image_disabled"/>
						<Action type="Hide" target="#image_enabled"/>
						<Action type="Hide" target="#mod_hover"/>
						<Action type="Hide" target="#mod_enabled"/>
						<Action type="Hide" target="#checkbox_hover"/>
					</OnOpen>
					<OnHover>
						<Action type="Show" target="#mod_hover"/>
						<Action type="Show" target="#checkbox_hover"/>
					</OnHover>
					<OnHoverEnd>
						<Action type="Hide" target="#checkbox_hover"/>
						<Action type="Hide" target="#mod_hover"/>
					</OnHoverEnd>
					<OnClick>
						<Action type="Show" target="#checkbox_enabled"/>
						<Action type="Hide" target="#checkbox_disabled"/>
						<Action type="TriggerEvent" target="GUI_GAME_MODS_ENABLED_MOD"/>
					</OnClick>
				</UncheckedState>

				<CheckedState sizeX="458" sizeY="397">
					<OnOpen>
						<Action type="Show" target="#image_enabled"/>
						<Action type="Hide" target="#image_disabled"/>
						<Action type="Show" target="#mod_enabled"/>
						<Action type="Hide" target="#mod_hover"/>
					</OnOpen>
					<OnHover>
						<Action type="Show" target="#mod_hover"/>
						<Action type="Show" target="#checkbox_hover"/>
					</OnHover>
					<OnHoverEnd>
						<Action type="Hide" target="#checkbox_hover"/>
						<Action type="Hide" target="#mod_hover"/>
					</OnHoverEnd>
					<OnClick>
						<Action type="Hide" target="#checkbox_enabled"/>
						<Action type="Show" target="#checkbox_disabled"/>
						<Action type="TriggerEvent" target="GUI_GAME_MODS_DISABLED_MOD"/>
					</OnClick>
				</CheckedState>

				<StaticImage name="#mod_enabled" origin="0 0" align="c" sizeX="458" sizeY="397" hidden="true">
					<StaticImage align="t" origin="0 0">
						<RenderObject2D texture="data/textures/gui/square.tga" sizeX="458" sizeY="4" color="f0e3cc"/>
					</StaticImage>
					<StaticImage align="b" origin="0 0">
						<RenderObject2D texture="data/textures/gui/square.tga" sizeX="458" sizeY="4" color="f0e3cc"/>
					</StaticImage>
					<StaticImage align="l" origin="0 0">
						<RenderObject2D texture="data/textures/gui/square.tga" sizeX="4" sizeY="397" color="f0e3cc"/>
					</StaticImage>
					<StaticImage align="r" origin="0 0">
						<RenderObject2D texture="data/textures/gui/square.tga" sizeX="4" sizeY="397" color="f0e3cc"/>
					</StaticImage>
				</StaticImage>

				<StaticImage name="#mod_hover" origin="0 0" align="c" sizeX="458" sizeY="397" hidden="true">
					<StaticImage align="t" origin="0 0">
						<RenderObject2D texture="data/textures/gui/square.tga" sizeX="458" sizeY="4" color="f97b03"/>
					</StaticImage>
					<StaticImage align="b" origin="0 0">
						<RenderObject2D texture="data/textures/gui/square.tga" sizeX="458" sizeY="4" color="f97b03"/>
					</StaticImage>
					<StaticImage align="l" origin="0 0">
						<RenderObject2D texture="data/textures/gui/square.tga" sizeX="4" sizeY="397" color="f97b03"/>
					</StaticImage>
					<StaticImage align="r" origin="0 0">
						<RenderObject2D texture="data/textures/gui/square.tga" sizeX="4" sizeY="397" color="f97b03"/>
					</StaticImage>
				</StaticImage>
				
				<Item name="#checkbox_disabled" align="i">
					<StaticImage align="lb" origin="2 4" hidden="true">
						<RenderObject2D texture="data/textures/gui/mod_status_inactive.dds"/>
					</StaticImage>
					<StaticImage align="t" origin="0 -4">
						<RenderObject2D texture="data/textures/gui/square.tga" sizeX="450" sizeY="323" color="7f7f7fff" blendMode="multiply"/>
					</StaticImage>
					<!-- <StaticText align="l" origin="66 0" text="@menu_mods_disabled" font="paragraph_3" textColor="f0e3cc"/> -->
				</Item>
			
			</Checkbox>
			
			<!-- footer2: buttons background -->
			<StaticImage origin="0 0" align="bc" sizeX="450" sizeY="70" hidden="false" clipChildren="true">
				<!-- <RenderObject2D texture="data/textures/gui/square.tga" sizeX="450" sizeY="70" color="211e1d"/> -->

				<StaticImage origin="0 0" align="lb">
					<RenderObject2D texture="data/textures/gui/deploy/deploy_class_diagonalbars.dds" sizeX="260" sizeY="102" color="211e1d90"/>
				</StaticImage>
				<StaticImage origin="0 0" align="rb">
					<RenderObject2D texture="data/textures/gui/deploy/deploy_class_diagonalbars.dds" flipX="true" sizeX="260" sizeY="102" color="211e1d90"/>
				</StaticImage>
			
				<StaticImage name="#checkbox_enabled" align="lb" origin="2 4" hidden="true">
					<RenderObject2D texture="data/textures/gui/mod_status_active.dds"/>
					<!-- <StaticText align="l" origin="66 0" text="@menu_mods_enabled" font="paragraph_3" textColor="f0e3cc"/> -->
				</StaticImage>
				<StaticImage name="#checkbox_hover" align="lb" origin="2 4" hidden="true">
					<RenderObject2D texture="data/textures/gui/mod_status_hover.dds" color="f97b03"/>
				</StaticImage>					

				<Button hidden="false" name="#UploadButton" align="r" origin="-4 0" tooltip="@ed_publish">
					<RenderObject2D texture="data/textures/gui/mod_upload.dds"/>
					<OnHover>
						<RenderObject2D texture="data/textures/gui/mod_upload_hover.dds"/>
					</OnHover>
					<OnClick>
						<RenderObject2D texture="data/textures/gui/mod_upload.dds"/>
						<Action type="TriggerEvent" target="GUI_GAME_MODS_UPLOAD"/>
					</OnClick>
				</Button>

				<!-- workshop-related buttons -->
				<Button hidden="true" name="#UnsubscribeButton" align="r" origin="-4 0" tooltip="@menu_mods_unsubscribe">
					<RenderObject2D texture="data/textures/gui/mod_remove.dds" color="ffffffff"/>
					<OnHover>
						<RenderObject2D texture="data/textures/gui/mod_remove_hover.dds"/>
					</OnHover>
					<OnClick>
						<RenderObject2D texture="data/textures/gui/mod_remove.dds"/>
						<Action type="TriggerEvent" target="GUI_GAME_MODS_UNSUBSCRIBE"/>
					</OnClick>
				</Button>

				<Checkbox hidden="false" name="#ThumbsUpButton" align="r" origin="-134 0" tooltip="@menu_mods_thumbsup_ttip" defaultState="UncheckedState">
					<UncheckedState>
						<RenderObject2D texture="data/textures/gui/mod_thumbsup.dds" color="ffffff12"/>
						<OnHover>
							<RenderObject2D texture="data/textures/gui/mod_thumbsup_hover.dds"/>
						</OnHover>
						<OnClick>
							<RenderObject2D texture="data/textures/gui/mod_thumbsup.dds"/>
							<Action type="TriggerEvent" target="GUI_GAME_MODS_THUMBS_UP"/>
						</OnClick>
					</UncheckedState>

					<CheckedState acceptInput="false">
						<RenderObject2D texture="data/textures/gui/mod_thumbsup.dds" color="ffffff"/>
						<OnHover>
							<RenderObject2D texture="data/textures/gui/mod_thumbsup_hover.dds"/>
						</OnHover>
					</CheckedState>
				</Checkbox>

				<Button hidden="false" name="#OpenInWorkshopButton" align="r" origin="-70 0" tooltip="@menu_m_show_in_workshop">
					<RenderObject2D texture="data/textures/gui/mod_info.dds" color="ffffff12" />
					<OnHover>
						<RenderObject2D texture="data/textures/gui/mod_info_hover.dds"  />
					</OnHover>
					<OnClick>
						<RenderObject2D texture="data/textures/gui/mod_info.dds" />
						<Action type="TriggerEvent" target="GUI_GAME_MODS_OPEN_IN_BROWSER"/>
					</OnClick>
				</Button>
				
				<!--
				<Button hidden="false" name="#OpenInFolderButton" align="rb" origin="-8 8" tooltip="@menu_m_show_in_workshop">
					<RenderObject2D texture="data/textures/gui/mod_info.dds" color="ffffff12" />
